# Mock mode is the safe, fully interactive demo mode.
VITE_USE_MOCK_API=true

# These values are public in the browser bundle. Never put secrets here.
VITE_IDENTITY_API_URL=http://localhost:3001
VITE_BOOKING_API_URL=http://localhost:3002
VITE_NOTIFICATION_API_URL=http://localhost:3003

# Optional request timeout in milliseconds for real API mode.
VITE_API_TIMEOUT_MS=10000
